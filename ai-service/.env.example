AI_SERVICE_TOKEN=replace-with-a-long-random-internal-service-token
AI_HOST=127.0.0.1
AI_PORT=8001

# Local persistent Qdrant mode requires no Docker server.
QDRANT_PATH=./data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=e_biessa_parts

# Downloaded once on first indexing/search request and cached locally.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=./data/models

# Enable only after creating the local Ollama model described in training/README.md.
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=e-biessa-query-v2
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_KEEP_ALIVE=30m

# Optional zero-shot image identification. The image is processed transiently and
# is never used to infer vehicle compatibility. Install requirements-vision.txt first.
VISION_ENABLED=false
VISION_MODEL=openai/clip-vit-base-patch32
VISION_CACHE_DIR=./data/vision-models
VISION_MAX_IMAGE_BYTES=5242880
VISION_MAX_IMAGE_PIXELS=25000000
# Optional local classifier checkpoint; mount the same path for Docker deployment.
# VISION_CLASSIFIER_CHECKPOINT=./training/vision/runs/pilot-20261014/best.pt
VISION_MINIMUM_SCORE=0.35
VISION_MINIMUM_MARGIN=0.12
VISION_MINIMUM_SIMILARITY=0.20
VISION_MINIMUM_SIMILARITY_MARGIN=0.01
VISION_MINIMUM_UNTRAINED_SCORE=0.85

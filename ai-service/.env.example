AI_SERVICE_TOKEN=840c2194e16f99e26a30f8120cdf49d6bc4d593b18b8ef0c713b2951e6a641ed
AI_HOST=127.0.0.1
AI_PORT=8001

# Local persistent Qdrant mode requires no Docker server.
QDRANT_PATH=./data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=e_biessa_parts

# Downloaded once on first indexing/search request and cached locally.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_CACHE_DIR=./data/models

# Enable only after creating the local Ollama model described in training/README.md.
OLLAMA_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=e-biessa-query-v2
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_KEEP_ALIVE=30m

{
  "uid": "ebiessa-demo", "title": "E-biessa isolated deployment", "schemaVersion": 39,
  "refresh": "5s", "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "title": "Per-service scrape availability (not dependency readiness)", "type": "timeseries", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 8}, "datasource": {"type": "prometheus", "uid": "demo-prometheus"}, "targets": [{"expr": "up", "legendFormat": "{{job}} {{instance}}", "refId": "A"}]},
    {"id": 2, "title": "API requests / second", "type": "timeseries", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "demo-prometheus"}, "targets": [{"expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"demo-api\"}[1m]))", "legendFormat": "{{instance}}", "refId": "A"}]},
    {"id": 3, "title": "API 5xx / second", "type": "timeseries", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "demo-prometheus"}, "targets": [{"expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"demo-api\",status=~\"5..\"}[1m]))", "legendFormat": "{{instance}}", "refId": "A"}]}
  ]
}

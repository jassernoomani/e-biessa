DB_URL=jdbc:mysql://localhost:3306/marketplace?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# Vehicle catalog (disable temporarily if the public CarQuery service is unavailable)
CAR_QUERY_ENABLED=true
CAR_QUERY_BASE_URL=https://www.carqueryapi.com/api/0.3/
CAR_QUERY_TIMEOUT_SECONDS=5

# VIN decoding through the public NHTSA vPIC API (no API key required)
VIN_DECODER_ENABLED=true
VIN_DECODER_BASE_URL=https://vpic.nhtsa.dot.gov/api
VIN_DECODER_TIMEOUT_SECONDS=8
VIN_DECODER_CACHE_HOURS=24

# OAuth provider credentials (redirect URI: http://localhost:8080/login/oauth2/code/{provider})
OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Password recovery delivery (development exposes the code in the local UI)
RECOVERY_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
RECOVERY_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional production image storage
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phase 2 semantic search (must match ai-service/.env)
AI_SERVICE_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=replace-with-a-long-random-internal-service-token
AI_CONNECT_TIMEOUT_SECONDS=3
AI_READ_TIMEOUT_SECONDS=95
# Per authenticated user, or per direct client IP for guests.
AI_SEARCH_RATE_LIMIT_REQUESTS=12
AI_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
# Protect the local GPU from an unbounded Ollama request queue.
AI_SEARCH_MAX_CONCURRENT=2
AI_SEARCH_ACQUIRE_TIMEOUT_MS=500
AI_SEARCH_CACHE_SECONDS=120
